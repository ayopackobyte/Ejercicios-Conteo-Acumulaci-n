// ============================================================
// EJERCICIO 18
// Leer notas y calcular porcentaje de reprobados
// ============================================================

using System;

class Ejercicio18
{
    static void Main()
    {
        int reprobados = 0;
        double nota;
        int totalAlumnos = 10;

        Console.WriteLine("=== Porcentaje de reprobados ===");

        for (int i = 1; i <= totalAlumnos; i++)
        {
            Console.Write($"Ingresa la nota del alumno {i} (0-100): ");
            while (!double.TryParse(Console.ReadLine(), out nota) || nota < 0 || nota > 100)
            {
                Console.Write("Nota inválida. Ingresa un valor entre 0 y 100: ");
            }

            // Un alumno reprueba si su nota es menor a 70
            if (nota < 70)
            {
                reprobados++;
            }
        }

        // Calculamos el porcentaje: (reprobados / total) * 100
        double porcentaje = (double)reprobados / totalAlumnos * 100;

        Console.WriteLine($"\nReprobados: {reprobados} de {totalAlumnos}");
        Console.WriteLine($"Porcentaje de reprobados: {porcentaje:F2}%");
    }
}
